# Your health data never goes in the public repo. It lives on this Mac and,
# once sync is on, in a separate PRIVATE repo.
# Leading slash matters: a bare `data/` also matched app/data/, which quietly
# excluded every data module from the repo.
/data/

# macOS noise
.DS_Store
__pycache__/
*.pyc

# Clinical history: seeds the Mac once, then lives in your private synced data.
app/data/case.local.js

# Dev-only test harness
app/dev-tests.*

# Detailed README stays local: it describes your clinicians and history.
README.local.md
app/dev-merge.js
app/dev-engine.js

# Local notes (UX reviews etc.) — never in the public shell
*.local.md

# Frozen pre-redesign interface, served at /baseline/ for comparison.
/app-baseline/

# Clinician source documents. PERSONAL: this repo is public.
/intake/

# The time estimate tests, same class as the other dev-only harness files.
app/dev-timing.js
